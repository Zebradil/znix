#!/usr/bin/env bash
#
# Census or dump of Kubernetes resources. Runs as `kubectl inventory` (any
# kubectl-* on PATH becomes a subcommand) or directly as kubectl-inventory.

set -euo pipefail

readonly SELF="${0##*/}"

# Kinds are swept in batches: one `kubectl get k1,k2,...` per batch rather than
# one per kind. The cost of a sweep is dominated by kubectl process startup
# (TLS handshake + discovery cache), not by the API, so batching is what makes
# it fast -- measured 3.3s batched vs 22.8s per-kind over 120 kinds. Batching
# also makes kubectl prefix the NAME column with `kind/name`, which is where
# the census grouping key comes from.
readonly BATCH_SIZE=15
readonly DEFAULT_PARALLEL=16

# Kinds that cannot answer "what is still here". `events` and
# `events.events.k8s.io` are two API views of one set of objects, so counting
# both double-counts. The metrics kinds are computed by metrics-server and
# stored nowhere, so they can neither be left behind nor block a deletion.
readonly -a DENY_EXACT=(events events.events.k8s.io componentstatuses)
readonly DENY_REGEX='\.metrics\.k8s\.io$'
DENY_LIST="$(
    IFS=,
    echo "${DENY_EXACT[*]}"
)"
readonly DENY_LIST

# Accumulated across sweeps, reported on stderr at exit.
declare -a UNREADABLE=()
EXCLUDED_COUNT=0
TOTAL_KINDS=0

usage() {
    cat <<EOF
Usage: $SELF (-n NS | -A | --cluster)... [options]

Reports which Kubernetes resource kinds actually hold objects. Answers
"what is left in this namespace" and "why will this namespace not delete".

At least one scope flag is required. They combine.

Scope:
  -n, --namespace NS     Namespaced kinds in NS
  -A, --all-namespaces   Namespaced kinds across every namespace
      --cluster          Cluster-scoped kinds

Mode:
  (default)              Census: kinds that hold objects, and how many
      --dump             Dump full objects instead

Options:
      --format FMT       Census: count (default) | name | json
                         Dump:   yaml (default) | json
      --output-dir DIR   Dump to a tree, one file per kind. Implies --dump.
      --all-kinds        Do not apply the exclusion denylist
  -P, --parallel N       Concurrent kubectl invocations (default: $DEFAULT_PARALLEL)
      --context CTX      Passed to kubectl
      --kubeconfig PATH  Passed to kubectl
      --as USER          Passed to kubectl; answers "what can this identity see"
  -v, --verbose          Name the kinds that could not be read
  -h, --help             This message

Excluded unless --all-kinds: $DENY_LIST, *.metrics.k8s.io

A namespace in Terminating state is diagnosed from its status conditions
rather than swept: the namespace controller already knows which kind is
blocking, and that kind alone is then fetched in full to name the objects
holding finalizers.

A denied kind and an empty kind both contribute nothing to the census, so
unreadable kinds are always counted on stderr. An empty-looking result with a
warning attached is not the same answer as an empty namespace, and on a
cluster where you hold partial access it is the likelier one.
EOF
}

die() {
    echo "$SELF: $*" >&2
    exit 1
}

# --- argument parsing ------------------------------------------------------

NAMESPACE=""
ALL_NAMESPACES=false
CLUSTER_SCOPE=false
DUMP=false
FORMAT=""
OUTPUT_DIR=""
ALL_KINDS=false
PARALLEL=$DEFAULT_PARALLEL
VERBOSE=false
SELF_TEST=false
declare -a KUBECTL_GLOBAL=()

while [[ $# -gt 0 ]]; do
    # Accept --flag=value as well as --flag value, since every kubectl flag
    # this shadows takes both forms.
    if [[ $1 == --*=* ]]; then
        set -- "${1%%=*}" "${1#*=}" "${@:2}"
    fi
    case "$1" in
    -n | --namespace)
        NAMESPACE="${2:?--namespace needs a value}"
        shift 2
        ;;
    -A | --all-namespaces)
        ALL_NAMESPACES=true
        shift
        ;;
    --cluster)
        CLUSTER_SCOPE=true
        shift
        ;;
    --dump)
        DUMP=true
        shift
        ;;
    --format)
        FORMAT="${2:?--format needs a value}"
        shift 2
        ;;
    --output-dir)
        OUTPUT_DIR="${2:?--output-dir needs a value}"
        DUMP=true
        shift 2
        ;;
    --all-kinds)
        ALL_KINDS=true
        shift
        ;;
    -P | --parallel)
        PARALLEL="${2:?--parallel needs a value}"
        shift 2
        ;;
    --context)
        KUBECTL_GLOBAL+=(--context "${2:?--context needs a value}")
        shift 2
        ;;
    --kubeconfig)
        KUBECTL_GLOBAL+=(--kubeconfig "${2:?--kubeconfig needs a value}")
        shift 2
        ;;
    --as)
        KUBECTL_GLOBAL+=(--as "${2:?--as needs a value}")
        shift 2
        ;;
    -v | --verbose)
        VERBOSE=true
        shift
        ;;
    --self-test)
        SELF_TEST=true
        shift
        ;;
    -h | --help)
        usage
        exit 0
        ;;
    *)
        usage >&2
        die "unknown argument: $1"
        ;;
    esac
done

if ! $SELF_TEST && [[ -z $NAMESPACE ]] && ! $ALL_NAMESPACES && ! $CLUSTER_SCOPE; then
    usage >&2
    die "a scope is required: -n NS, -A, or --cluster"
fi
if [[ -n $NAMESPACE ]] && $ALL_NAMESPACES; then
    die "-n and -A are mutually exclusive"
fi
[[ $PARALLEL =~ ^[1-9][0-9]*$ ]] || die "--parallel must be a positive integer"

if [[ -z $FORMAT ]]; then
    $DUMP && FORMAT=yaml || FORMAT=count
fi
if $DUMP; then
    case "$FORMAT" in
    yaml | json) ;;
    *) die "--dump supports --format yaml or json, got: $FORMAT" ;;
    esac
else
    case "$FORMAT" in
    count | name | json) ;;
    *) die "census supports --format count, name, or json, got: $FORMAT" ;;
    esac
fi

kc() { kubectl "${KUBECTL_GLOBAL[@]+"${KUBECTL_GLOBAL[@]}"}" "$@"; }

WORK="$(mktemp -d "${TMPDIR:-/tmp}/kubectl-inventory.XXXXXX")"
trap 'rm -rf "$WORK"' EXIT

# Scopes are censused one at a time, but under --format json their objects are
# buffered here and merged into a single document at exit: two concatenated
# top-level objects are not JSON and neither jq nor json.load will take them.
readonly JSON_PARTS="$WORK/json.parts"

# --- kind enumeration ------------------------------------------------------

# Emits the listable kinds for one scope, denylist already applied.
enumerate_kinds() {
    local scoped=$1 # true for namespaced kinds, false for cluster-scoped
    local kind total=0 excluded=0 denied

    while read -r kind; do
        [[ -n $kind ]] || continue
        total=$((total + 1))
        if ! $ALL_KINDS; then
            denied=false
            for d in "${DENY_EXACT[@]}"; do
                if [[ $kind == "$d" ]]; then
                    denied=true
                    break
                fi
            done
            if [[ $kind =~ $DENY_REGEX ]]; then
                denied=true
            fi
            if $denied; then
                excluded=$((excluded + 1))
                continue
            fi
        fi
        echo "$kind"
    done < <(kc api-resources --verbs=list "--namespaced=$scoped" -o name 2>/dev/null)

    TOTAL_KINDS=$((TOTAL_KINDS + total))
    EXCLUDED_COUNT=$((EXCLUDED_COUNT + excluded))
}

# --- batched fetch ---------------------------------------------------------

# Blocks until fewer than $PARALLEL background jobs are running. Polling rather
# than `wait -n` so the script does not depend on a bash newer than 3.2.
throttle() {
    while [[ $(jobs -rp | wc -l) -ge $PARALLEL ]]; do
        sleep 0.05
    done
}

# One kubectl call for a batch of kinds. stdout, stderr and exit status are
# kept in separate files so the caller can tell a denied kind from an empty one.
fetch_batch() {
    local batch_file=$1 out=$2 err=$3 rc_file=$4
    shift 4
    local kinds rc=0
    kinds="$(paste -sd, - <"$batch_file")"
    kc get "$kinds" "$@" --ignore-not-found >"$out" 2>"$err" || rc=$?
    echo "$rc" >"$rc_file"
}

# True when a non-zero batch still produced complete output for the kinds it
# was allowed to read. A denied list is reported per kind and the rest of the
# batch is still returned, so there is nothing to retry -- and retrying would
# be actively harmful: on a restricted cluster every batch contains a denied
# kind, which would turn every batch into 15 individual calls. A discovery
# failure is the opposite: kubectl resolves all requested types before issuing
# any request, so one unresolvable type aborts the batch and prints nothing.
# Anything unrecognised is treated as an abort, since retrying is the safe
# direction to be wrong in.
batch_recoverable() {
    local err_file=$1
    [[ -s $err_file ]] || return 0
    ! grep -qvE '^(Warning:|Error from server \(Forbidden\):)' "$err_file"
}

# Splits kinds into batches, fetches them in parallel, and concatenates stdout.
sweep() {
    local kinds_file=$1
    shift
    local dir
    dir="$(mktemp -d "$WORK/sweep.XXXXXX")"
    split -l "$BATCH_SIZE" "$kinds_file" "$dir/batch."

    local b
    for b in "$dir"/batch.*; do
        throttle
        fetch_batch "$b" "$b.out" "$b.err" "$b.rc" "$@" &
    done
    wait

    for b in "$dir"/batch.*; do
        case "$b" in
        *.out | *.err | *.rc | *.one.*) continue ;;
        esac
        if [[ $(cat "$b.rc") -ne 0 ]] && ! batch_recoverable "$b.err"; then
            retry_individually "$b" "$@"
        else
            cat "$b.out"
            classify_errors "$b.err"
        fi
    done
}

retry_individually() {
    local batch_file=$1
    shift
    local kind i=0
    while read -r kind; do
        [[ -n $kind ]] || continue
        i=$((i + 1))
        throttle
        printf '%s\n' "$kind" >"$batch_file.one.$i"
        fetch_batch "$batch_file.one.$i" "$batch_file.one.$i.out" \
            "$batch_file.one.$i.err" "$batch_file.one.$i.rc" "$@" &
    done <"$batch_file"
    wait

    local n
    for n in $(seq 1 "$i"); do
        if [[ $(cat "$batch_file.one.$n.rc") -ne 0 ]]; then
            UNREADABLE+=("$(cat "$batch_file.one.$n"): $(head -1 "$batch_file.one.$n.err")")
        else
            cat "$batch_file.one.$n.out"
            classify_errors "$batch_file.one.$n.err"
        fi
    done
}

# A denied kind names itself on stderr and nowhere else -- it contributes no
# rows, so stderr is the only evidence it was ever attempted. Deprecation
# warnings share that channel and are not failures.
classify_errors() {
    local err_file=$1 line
    [[ -s $err_file ]] || return 0
    while read -r line; do
        case "$line" in
        Warning:*) ;;
        # A kind that resolved during discovery but 404s on the list call was
        # deleted mid-sweep (a CRD going away). It holds nothing, which is the
        # same answer as empty -- not a kind we failed to read.
        "Error from server (NotFound):"*) ;;
        "Error from server (Forbidden):"*)
            UNREADABLE+=("${line#Error from server (Forbidden): }")
            ;;
        *error:* | "Error"*)
            UNREADABLE+=("$line")
            ;;
        esac
    done <"$err_file"
}

# --- census ----------------------------------------------------------------

# Turns kubectl's table output into `kind<TAB>name` (plus namespace under -A).
# Batched output prefixes the NAME column with `kind/name`; under -A the first
# column is NAMESPACE and that prefixed column shifts to the second.
parse_rows() {
    local ns_column=$1
    local field=1
    $ns_column && field=2
    awk -v f="$field" -v withns="$ns_column" '
        /^NAME/ || /^NAMESPACE/ || NF == 0 { next }
        {
            split($f, parts, "/")
            if (withns == "true") print $1 "\t" parts[1] "\t" parts[2]
            else print "\t" parts[1] "\t" parts[2]
        }
    '
}

census() {
    local label=$1 rows_file=$2 ns_column=$3

    if [[ ! -s $rows_file ]]; then
        if [[ $FORMAT == json ]]; then
            jq -n --arg scope "$label" \
                '{ ($scope): { count: 0, kinds: {}, objects: [] } }' >>"$JSON_PARTS"
        else
            echo "no resources found in $label"
        fi
        return 0
    fi

    case "$FORMAT" in
    count)
        echo "── $label ──"
        awk -F'\t' '{ n[$2]++ } END { for (k in n) printf "%s\t%d\n", k, n[k] }' \
            "$rows_file" | sort -k2 -rn | column -t -s$'\t'
        ;;
    name)
        echo "── $label ──"
        if $ns_column; then
            { printf 'NAMESPACE\tKIND\tNAME\n'; sort "$rows_file"; } | column -t -s$'\t'
        else
            { printf 'KIND\tNAME\n'; cut -f2- "$rows_file" | sort; } | column -t -s$'\t'
        fi
        ;;
    json)
        jq -R -s --arg scope "$label" '
            [ split("\n")[] | select(length > 0) | split("\t")
              | { namespace: (if .[0] == "" then null else .[0] end),
                  kind: .[1], name: .[2] } ]
            | { ($scope): { count: length,
                            kinds: (group_by(.kind) | map({ (.[0].kind): length }) | add // {}),
                            objects: . } }
        ' "$rows_file" >>"$JSON_PARTS"
        ;;
    esac
}

# --- dump ------------------------------------------------------------------

# Batches are fetched as JSON and merged into one List, so consumers get a
# single document to walk rather than one file per kind to glob over.
dump() {
    local raw=$1
    if [[ ! -s $raw ]]; then
        echo "$SELF: nothing to dump" >&2
        return 0
    fi

    local merged="$WORK/merged.json"
    jq -s '{ apiVersion: "v1", kind: "List",
             items: (map(.items // []) | add // []) }' "$raw" >"$merged"

    if [[ -n $OUTPUT_DIR ]]; then
        mkdir -p "$OUTPUT_DIR"
        local key
        while read -r key; do
            [[ -n $key ]] || continue
            jq --arg k "$key" '
                { apiVersion: "v1", kind: "List",
                  items: [ .items[] | select((.kind + "." + (.apiVersion | split("/")[0])) == $k) ] }
            ' "$merged" | to_format >"$OUTPUT_DIR/$(echo "$key" | tr '[:upper:]' '[:lower:]').${FORMAT}"
        done < <(jq -r '.items[] | .kind + "." + (.apiVersion | split("/")[0])' "$merged" | sort -u)
        echo "$SELF: wrote $(find "$OUTPUT_DIR" -type f | wc -l | tr -d ' ') files to $OUTPUT_DIR" >&2
    else
        to_format <"$merged"
    fi
}

to_format() {
    if [[ $FORMAT == yaml ]]; then
        yq -p json -o yaml
    else
        cat
    fi
}

# --- terminating namespace -------------------------------------------------

# Reads a namespace conditions array and emits the still-populated kinds as a
# comma-separated list ready for `kubectl get`.
#
# NamespaceContentRemaining names kinds but never objects: the controller
# deletes whole collections and only counts what survived, so it never holds
# individual identities. Each kind appears as "<kind>. has N resource
# instances", repeated comma-separated when several are stuck, so the whole
# message is scanned rather than matched once. Kind names contain dots of their
# own (addons.k3s.cattle.io), hence anchoring on the literal ". has".
parse_remaining_kinds() {
    jq -r '
        .[] | select(.type == "NamespaceContentRemaining") | .message
        | [ match("([a-z0-9.-]+)\\. has"; "g").captures[0].string ] | join(",")
    ' 2>/dev/null || true
}

# The namespace controller records what is blocking deletion in the namespace's
# own status. That is one API call and it also covers the case a sweep cannot
# diagnose at all: discovery failing because an aggregated API is down.
diagnose_terminating() {
    local ns=$1 status
    status="$(kc get namespace "$ns" -o json 2>/dev/null | jq -c '.status' 2>/dev/null)" || return 1
    [[ $(jq -r '.phase // ""' <<<"$status") == Terminating ]] || return 1

    echo "── namespace $ns is Terminating ──"

    local conditions
    conditions="$(jq -c '.conditions // []' <<<"$status")"
    if [[ $conditions == "[]" ]]; then
        # The controller writes conditions on its retry loop, roughly 20s after
        # the delete. Absent conditions this early mean "not reported yet",
        # which is a different answer from "nothing is blocking".
        echo "status conditions not written yet; the namespace controller reports"
        echo "after its first reconcile (~20s). Re-run shortly."
        return 0
    fi

    jq -r '.[] | select(.status == "True") | "  \(.type): \(.message)"' <<<"$conditions"

    if [[ $(jq -r '.[] | select(.type == "NamespaceDeletionDiscoveryFailure") | .status' <<<"$conditions") == True ]]; then
        echo
        echo "Discovery is failing, so a resource sweep cannot be trusted either."
        echo "Check for an aggregated APIService whose backend is unavailable:"
        echo "  kubectl get apiservices | grep -v True"
        return 0
    fi

    local remaining
    remaining="$(parse_remaining_kinds <<<"$conditions")"
    [[ -n $remaining ]] || return 0

    echo
    echo "objects holding the namespace open:"
    kc get "$remaining" -n "$ns" -o json --ignore-not-found 2>/dev/null | jq -r '
        .items[]? | select(.metadata.deletionTimestamp != null)
        | "  \(.kind | ascii_downcase)/\(.metadata.name)  finalizers: \(.metadata.finalizers // [] | join(", "))"
    '
}

# --- self test -------------------------------------------------------------

# Offline checks for the two pieces that parse text no API contract covers:
# error classification and kubectl's human table. Run by `nix flake check`.
self_test() {
    local failures=0

    check() {
        if [[ $3 == "$2" ]]; then
            echo "ok   $1"
        else
            echo "FAIL $1: want [$2] got [$3]"
            failures=$((failures + 1))
        fi
    }

    local err="$WORK/t.err"
    : >"$err"
    check "empty stderr is recoverable" recoverable \
        "$(batch_recoverable "$err" && echo recoverable || echo abort)"

    printf 'Warning: v1 Endpoints is deprecated\nError from server (Forbidden): pods is forbidden\n' >"$err"
    check "forbidden alone is recoverable" recoverable \
        "$(batch_recoverable "$err" && echo recoverable || echo abort)"

    printf 'error: the server does not have a resource type "bogus"\n' >"$err"
    check "unknown type aborts the batch" abort \
        "$(batch_recoverable "$err" && echo recoverable || echo abort)"

    printf 'Error from server (Forbidden): pods is forbidden\nerror: the server does not have a resource type "bogus"\n' >"$err"
    check "forbidden mixed with unknown aborts" abort \
        "$(batch_recoverable "$err" && echo recoverable || echo abort)"

    check "table rows split kind from name" 'configmap|foo,addon.k3s.cattle.io|bar' \
        "$(printf 'NAME       DATA  AGE\nconfigmap/foo  1  3d\n\nNAME  AGE\naddon.k3s.cattle.io/bar  5d\n' |
            parse_rows false | awk -F'\t' '{ printf "%s%s|%s", (NR>1 ? "," : ""), $2, $3 }')"

    check "namespace column shifts the parse" 'kube-system|configmap|foo' \
        "$(printf 'NAMESPACE    NAME           DATA  AGE\nkube-system  configmap/foo  1  3d\n' |
            parse_rows true | awk -F'\t' '{ printf "%s|%s|%s", $1, $2, $3 }')"

    check "several stuck kinds are all extracted" 'configmaps,secrets' \
        "$(parse_remaining_kinds <<<'[{"type":"NamespaceContentRemaining","message":"Some resources are remaining: configmaps. has 1 resource instances, secrets. has 1 resource instances"}]')"

    check "dotted group survives extraction" 'addons.k3s.cattle.io' \
        "$(parse_remaining_kinds <<<'[{"type":"NamespaceContentRemaining","message":"Some resources are remaining: addons.k3s.cattle.io. has 2 resource instances"}]')"

    if [[ $failures -gt 0 ]]; then
        echo "$failures check(s) failed" >&2
        return 1
    fi
    echo "all checks passed"
}

# --- main ------------------------------------------------------------------

report_notes() {
    if [[ $EXCLUDED_COUNT -gt 0 ]]; then
        echo "$SELF: excluded $EXCLUDED_COUNT of $TOTAL_KINDS kinds ($DENY_LIST, *.metrics.k8s.io); --all-kinds to include" >&2
    fi
    local n=${#UNREADABLE[@]}
    if [[ $n -gt 0 ]]; then
        echo "$SELF: warning: $n kinds could not be read; results are incomplete" >&2
        if $VERBOSE; then
            printf '  %s\n' "${UNREADABLE[@]}" >&2
        else
            echo "  --verbose to list them" >&2
        fi
    fi
}

run_scope() {
    local label=$1 scoped=$2 ns_column=$3
    shift 3

    local kinds="$WORK/kinds.$scoped"
    enumerate_kinds "$scoped" >"$kinds"
    [[ -s $kinds ]] || die "no listable kinds found (is the cluster reachable?)"

    if $DUMP; then
        sweep "$kinds" "$@" -o json >>"$WORK/dump.raw"
    else
        # sweep is redirected rather than piped: a pipe would run it in a
        # subshell and discard the unreadable-kind list it accumulates.
        local raw="$WORK/raw.$scoped" rows="$WORK/rows.$scoped"
        sweep "$kinds" "$@" >"$raw"
        parse_rows "$ns_column" <"$raw" >"$rows"
        census "$label" "$rows" "$ns_column"
    fi
}

if $SELF_TEST; then
    self_test
    exit 0
fi

# A Terminating namespace is answered from its status, not by sweeping it. Only
# the namespaced scope is answered this way; --cluster, if also asked for, is
# still swept below.
DIAGNOSED=false
if [[ -n $NAMESPACE ]] && ! $DUMP && diagnose_terminating "$NAMESPACE"; then
    DIAGNOSED=true
fi

: >"$WORK/dump.raw"
: >"$JSON_PARTS"

if ! $DIAGNOSED; then
    if [[ -n $NAMESPACE ]]; then
        run_scope "namespaced: $NAMESPACE" true false -n "$NAMESPACE"
    elif $ALL_NAMESPACES; then
        run_scope "namespaced: all namespaces" true true --all-namespaces
    fi
fi

if $CLUSTER_SCOPE; then
    if { [[ -n $NAMESPACE ]] || $ALL_NAMESPACES; } && ! $DUMP; then
        echo
    fi
    run_scope "cluster-scoped" false false
fi

if $DUMP; then
    dump "$WORK/dump.raw"
elif [[ -s $JSON_PARTS ]]; then
    jq -s add "$JSON_PARTS"
fi

report_notes
